{
  "name": "floe-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "build": "oxlint --deny-warnings && tsc --noEmit && node --experimental-strip-types --test src/admin/schema-form.test.ts src/admin/toml-lines.test.ts && vite build && vite build -c vite.sdk.config.ts",
    "preview": "vite preview",
    "build:sdk": "vite build -c vite.sdk.config.ts",
    "test": "node --experimental-strip-types --test src/admin/schema-form.test.ts src/admin/toml-lines.test.ts"
  },
  "dependencies": {
    "@pierre/diffs": "^1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
