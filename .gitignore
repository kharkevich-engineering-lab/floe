target/
*.orig

# local secrets / environment — never in the repo
.env
.env.*
*.senv
.senv
.dev/
.pi/

# local review dumps (findings, smoketests, notes — not for the repo)
.review/

# built web assets (embedded into the binary at build time; `just web-build`)
web/dist/
web/node_modules/
node_modules/

# nix build outputs
result
result-*

# Helm chart dependencies: fetched by `helm dependency update` (Chart.yaml pins exact versions,
# so no Chart.lock is kept)
deploy/helm/*/charts/
deploy/helm/*/Chart.lock
